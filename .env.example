# ==============================================================================
# LOCUS - COEP Technological University Venue Booking System
# Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local and update with your own keys:
# cp .env.example .env.local

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL Configuration
# ------------------------------------------------------------------------------
# Dashboard: https://supabase.com/dashboard/project/ozdthbfemtuaefrrxwnm

# Optional: Server-side API Supabase Configuration (do not expose service key to browser)
SUPABASE_URL=https://ozdthbfemtuaefrrxwnm.supabase.co
SUPABASE_ANON_KEY=your-anon-key-from-supabase-dashboard
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 2. Microsoft Entra ID (Azure AD) / Outlook 365 Authentication (Optional)
# ------------------------------------------------------------------------------
# Register a Single Page Application (SPA) in Azure Portal (portal.azure.com)
# Set Redirect URI to: http://localhost:5173
VITE_AZURE_CLIENT_ID=your-azure-app-client-id
VITE_AZURE_TENANT_ID=common

# ------------------------------------------------------------------------------
# 3. Email Dispatch (Optional: for Outlook OTP verification)
# ------------------------------------------------------------------------------
# Option A: Free Email Dispatch WITHOUT Domain (Gmail SMTP via App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="COEP LOCUS <your-email@gmail.com>"

# Option B: Resend API Key (Delivers to account email in sandbox mode)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=onboarding@resend.dev
