# Copy this file to .env.local and update with your own local/dev values

# Supabase PostgreSQL Configuration
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Microsoft Entra ID (Azure AD) / Outlook 365 Authentication
# Register a Single Page Application (SPA) in Azure Portal (portal.azure.com)
# Set Redirect URI to: http://localhost:5173
VITE_AZURE_CLIENT_ID=your-azure-app-client-id
VITE_AZURE_TENANT_ID=common

# Option 1: Free Email Dispatch WITHOUT Domain (Gmail SMTP via App Password)
# 1. Enable 2-Step Verification on your Google Account
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Enter your email and app password below to send to ANY email address:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="COEP LOCUS <your-email@gmail.com>"

# Option 2: Resend API Key (Delivers to your account email in sandbox mode, or any email with verified domain)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=onboarding@resend.dev

